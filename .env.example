APP_ENV=development
BUILD_SHA=development
APP_NAME=customer-support-agent
LOG_LEVEL=INFO
AUTH_MODE=session
EMAIL_LOGIN_ENABLED=true
INVITE_REGISTRATION_ENABLED=true
SELF_SERVICE_SIGNUP_ENABLED=false
SELF_SERVICE_SIGNUP_MODE=provision_tenant
EMPLOYEE_ENROLLMENT_ENABLED=false
TRUSTED_PROXY_CIDRS=[]
ENROLLMENT_TOKEN_SECRET=development-only-enrollment-token-secret-change-before-production
ENROLLMENT_INTENT_TTL_SECONDS=1800
ENROLLMENT_VERIFICATION_TTL_SECONDS=1800
SITE_VERIFICATION_TTL_SECONDS=3600
MOCK_SUBJECT_ID=dev-customer
ADMIN_SESSION_COOKIE_NAME=support_admin_session
LOGIN_COMPLETION_COOKIE_NAME=support_login_completion
ADMIN_SESSION_TTL_SECONDS=43200
PASSWORD_RESET_TTL_SECONDS=1800
ADMIN_PUBLIC_BASE_URL=http://localhost:8090
EXTERNAL_LOGIN_PROVIDERS=[]
DINGTALK_LOGIN_ENABLED=false
LEGACY_LOGIN_ENABLED=true
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ORGANIZATION_ID=
DINGTALK_TIMEOUT_SECONDS=10
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ENFORCE_BROWSER_ORIGIN=true
ADMIN_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
BOOTSTRAP_ADMIN_DISPLAY_NAME=Tenant Owner
BOOTSTRAP_PLATFORM_OWNER=false
ALLOWED_ORIGINS=["http://localhost:8090","http://127.0.0.1:8090","http://localhost:5173","http://127.0.0.1:5173"]
DEFAULT_TENANT_ID=tenant-demo
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_agent
# Optional outside production. Alembic prefers this URL when it is set.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=2
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_PREPARED_STATEMENT_CACHE_SIZE=100
QDRANT_URL=http://localhost:6333
QDRANT_TRUST_ENV=false
QDRANT_STARTUP_RETRY_MAX_SECONDS=30
QDRANT_COLLECTION=customer_support_knowledge_v1
QDRANT_MAINTENANCE_TIMEOUT_SECONDS=900
KNOWLEDGE_INDEX_SCHEMA_VERSION=hybrid-v2
EMBEDDING_DIMENSION=64
TENANT_EXPERIENCE_ENABLED=true
TENANT_EXPERIENCE_RELEASE_MODE=shadow
TENANT_EXPERIENCE_RELEASE_VERSION=experience-v1
TENANT_EXPERIENCE_ROLLOUT_PERCENT=0
TENANT_EXPERIENCE_RESULT_LIMIT=2
TENANT_EXPERIENCE_MAXIMUM_ONLINE_RISK=1
TENANT_EXPERIENCE_EMBEDDING_DIMENSION=384
TENANT_EXPERIENCE_MINIMUM_SIMILARITY=0.35
TENANT_EXPERIENCE_RETRIEVAL_TIMEOUT_SECONDS=0.15
TENANT_EXPERIENCE_CASE_TTL_DAYS=90
TENANT_EXPERIENCE_OUTCOME_OBSERVATION_DAYS=7
TENANT_EXPERIENCE_WORKER_BATCH_SIZE=100
TENANT_EXPERIENCE_WORKER_POLL_SECONDS=60
TENANT_EXPERIENCE_WORKER_TENANT_IDS=["tenant-demo"]
TENANT_EXPERIENCE_GUARDRAIL_MINIMUM_SAMPLES=30
TENANT_EXPERIENCE_MAXIMUM_NEGATIVE_TRANSFER_RATE=0.25
TENANT_EXPERIENCE_MAXIMUM_FAILURE_RATE_DELTA=0.05
HYBRID_TENANT_CANDIDATE_LIMIT=40
HYBRID_GLOBAL_CANDIDATE_LIMIT=30
HYBRID_RERANK_CANDIDATE_LIMIT=30
HYBRID_TENANT_WEIGHT=0.65
HYBRID_GLOBAL_WEIGHT=0.35
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_CACHE_DIR=./.cache/fastembed
LOCAL_EMBEDDING_THREADS=4
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_CACHE_MAX_ENTRIES=4096
# Preload the local model so the first customer request does not pay cold-start cost.
LOCAL_EMBEDDING_PREWARM=true
TENANT_KNOWLEDGE_ROOT=./examples/knowledge-sources/tenants
GLOBAL_VAULT_PATH=./examples/global-vault
BACKUP_STATUS_DIRECTORY=./backups/status
BACKUP_MAX_AGE_HOURS=36
RETENTION_EXECUTION_ENABLED=false
RETENTION_POLICY_VERSION=draft-v1
RETENTION_ADMIN_SESSION_DAYS=30
RETENTION_EXPIRED_MEMORY_GRACE_DAYS=7
RETENTION_SUPPORT_OPERATION_DAYS=90
RETENTION_AUDIT_EVENT_DAYS=365
SEED_MOCK_BUSINESS_DATA=true
PLATFORM_GLOBAL_SYNC_ENABLED=false
# Static bootstrap fallback; Dashboard-managed site credentials are preferred.
WIDGET_SITE_KEYS={}
# Deprecated compatibility fallback. Do not configure the same key twice.
WORDPRESS_SITE_KEYS={}
PUBLIC_WIDGET_BASE_URL=http://localhost:8000
WIDGET_TOKEN_SECRET=replace-with-at-least-32-random-characters
WIDGET_TOKEN_TTL_SECONDS=900
WIDGET_RESUME_TOKEN_TTL_SECONDS=2592000
WIDGET_BOOTSTRAP_RATE_LIMIT_PER_MINUTE=30
WIDGET_CHAT_RATE_LIMIT_PER_MINUTE=20
WIDGET_PRESENCE_RATE_LIMIT_PER_MINUTE=6
WIDGET_PRESENCE_SOURCE_RATE_LIMIT_PER_MINUTE=120
WIDGET_PRESENCE_SITE_RATE_LIMIT_PER_MINUTE=30000
WIDGET_DEFAULT_DAILY_MESSAGE_LIMIT=500
WIDGET_ASSET_STORAGE_BACKEND=filesystem
WIDGET_ASSET_STORAGE_PATH=./data/widget-assets
WIDGET_ASSET_MAX_UPLOAD_BYTES=2000000
# Production multi-replica deployments should use a private S3-compatible bucket.
WIDGET_ASSET_S3_BUCKET=
WIDGET_ASSET_S3_PREFIX=widget-assets
WIDGET_ASSET_S3_ENDPOINT_URL=
WIDGET_ASSET_S3_REGION=
WIDGET_ASSET_S3_ACCESS_KEY_ID=
WIDGET_ASSET_S3_SECRET_ACCESS_KEY=
WIDGET_SITE_CACHE_TTL_SECONDS=10
WIDGET_SITE_NEGATIVE_CACHE_TTL_SECONDS=5
WIDGET_SITE_DB_FALLBACK_CONCURRENCY=10
WIDGET_CHAT_GLOBAL_CONCURRENCY=100
WIDGET_CHAT_SITE_CONCURRENCY=20
WIDGET_CHAT_CAPACITY_WAIT_SECONDS=1.5
WIDGET_CHAT_CAPACITY_LEASE_SECONDS=90
WIDGET_CHAT_DEADLINE_SECONDS=30
WIDGET_SSE_ENABLED=true
WIDGET_SSE_HEARTBEAT_SECONDS=15
WIDGET_SSE_MAX_CONNECTION_SECONDS=300

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_API_MODE=chat_completions
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_CHAT_PREWARM=true
TURN_PLANNER_MODE=conditional
SEMANTIC_REVIEWER_MODE=conditional
DETERMINISTIC_RENDER_ENABLED=true
MODEL_GATEWAY_ENABLED=true
MODEL_GATEWAY_REQUESTS_PER_MINUTE=3000
MODEL_GATEWAY_TOKENS_PER_MINUTE=3000000
MODEL_GATEWAY_RESERVED_OUTPUT_TOKENS=1200
MODEL_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_CIRCUIT_RECOVERY_SECONDS=30

# Per-site human handoff email. Keys are trusted site_id values.
HANDOFF_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_STARTTLS=true
HANDOFF_EMAIL_RECIPIENTS={}
WEB_CRAWLER_ENABLED=false
WEB_CRAWLER_PRODUCTION_SYNC_ENABLED=false
WEB_CRAWLER_PREFLIGHT_MAX_SITEMAPS=500
WEB_CRAWLER_SITEMAP_MAX_RESPONSE_BYTES=10000000
WEB_CRAWLER_SITEMAP_MAX_DECOMPRESSED_RESPONSE_BYTES=20000000
WEB_CRAWLER_MANIFEST_MAX_AGE_HOURS=24
WEB_CRAWLER_MAX_PAGES=500
WEB_CRAWLER_MANIFEST_SAFETY_CEILING=50000
WEB_CRAWLER_FULL_SHADOW_ENABLED=true
WEB_CRAWLER_MAX_SITEMAPS=3
WEB_CRAWLER_MAX_RESPONSE_BYTES=2000000
WEB_CRAWLER_MAX_DECOMPRESSED_RESPONSE_BYTES=4000000
WEB_CRAWLER_MAX_COMPRESSION_RATIO=50
WEB_CRAWLER_REQUEST_TIMEOUT_SECONDS=15
WEB_CRAWLER_DELAY_SECONDS=0.5
WEB_CRAWLER_FOLLOW_INTERNAL_LINKS=true
WEB_CRAWLER_RESPECT_ROBOTS_TXT=true
WEB_CRAWLER_BATCH_SIZE=250
WEB_SYNC_WORKER_POLL_SECONDS=5
WEB_SYNC_WORKER_CONCURRENCY=4
WEB_SYNC_DOMAIN_CONCURRENCY=2
WEB_SYNC_PREPARE_BATCH_SIZE=500
WEB_SYNC_WORKER_LEASE_SECONDS=120
WEB_SYNC_WORKER_HEARTBEAT_SECONDS=30
# API and worker must resolve this to the same file. Docker Compose overrides it with a shared path.
WEB_SYNC_WORKER_HEARTBEAT_PATH=.cache/web-sync-worker/heartbeat
WEB_SYNC_STAGING_RETENTION_HOURS=48
WEB_SYNC_MAX_ACTIVE_TENANTS=4
WEB_SYNC_MAX_PAGES_IN_FLIGHT=8
WEB_SYNC_MAX_PAGES_PER_TENANT=2
WEB_SYNC_MAX_FINALIZATIONS=1
WEB_SYNC_WORK_QUANTUM_PAGES=20
WEB_SYNC_WORK_QUANTUM_SECONDS=30
WEB_SYNC_TENANT_WATCHDOG_SECONDS=1020
WEB_SYNC_MAX_NO_PROGRESS_SECONDS=90
WEB_SYNC_FINALIZATION_TIMEOUT_SECONDS=960
WEB_SYNC_TENANT_DISCOVERY_SECONDS=10
WEB_SYNC_IDLE_BACKOFF_MAX_SECONDS=30
WEB_SYNC_WORKER_REGISTRY_TTL_SECONDS=90
DUPLICATE_PRODUCT_POLICY=first_wins
DUPLICATE_PRODUCT_ORDER=manifest_ordinal
PRODUCT_SPECIFICATION_MAX_AGE_DAYS=30
PRODUCT_PRICE_MAX_AGE_DAYS=7
PRODUCT_STOCK_MAX_AGE_DAYS=7
FAQ_ANSWER_CACHE_TTL_SECONDS=300
FAQ_ANSWER_CACHE_MAX_ENTRIES=1000
