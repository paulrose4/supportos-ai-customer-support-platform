# Copy to .env.load-test or export these variables explicitly.
# Never point the capacity, peak, or soak profiles at production.
BASE_URL=https://staging.example.com
ORIGIN=https://load-origin.example.com
PUBLIC_WIDGET_ID=site_pub_replace_with_staging_widget_id
PROFILE=smoke
CONFIRM_STAGING=1
SHARD_ID=0
VUS=10
HEARTBEAT_MIN_SECONDS=20
HEARTBEAT_MAX_SECONDS=25
K6_IMAGE=grafana/k6:0.57.0
# Set K6_SCRIPT=admin-presence.js for the administrator list test.
K6_SCRIPT=presence.js
ADMIN_COOKIE_NAME=support_admin_session
ADMIN_EXPECTED_MIN_ITEMS=9800
ADMIN_TEST_DURATION=30m
# Keep the real value only in the untracked .env.load-test file.
ADMIN_SESSION_TOKEN=
SUMMARY_PATH=/results/presence-summary.json
